# ============================================
# Files to ignore in Vercel deployment
# ============================================
# Dependencies
node_modules/
package-lock.json
yarn.lock

# Build files (Vercel will rebuild)
dist/
build/

# Environment
.env*
!.env.example

# Git
.git/
.gitignore
.gitattributes

# IDE
.vscode/
.idea/
*.iml
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Logs
*.log
logs/

# Tests
coverage/
.nyc_output/
test-results/

# Documentation
README.md
*.md
docs/

# Misc
.travis.yml
.github/
.gitlab-ci.yml
*.bak
*.tmp