{
  "version": 2,
  "builds": [
    {
      "src": "ugwunagbo-frontend/dist/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "https://ugwunagbo-backend.onrender.com/api/$1"
    },
    {
      "src": "/(.*)",
      "dest": "/ugwunagbo-frontend/dist/index.html"
    }
  ]
}